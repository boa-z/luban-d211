#!/bin/sh
#
# Bring up the onboard AIC8800 SDIO Wi-Fi.
#
# The module needs a few seconds after a cold power-on before its SDIO
# interface answers; the host polls for it (broken-cd in the device
# tree).  Never unbind/rebind the SDMC2 driver here: its timer/DMA
# teardown is not re-entrant and the rebind panics the kernel.
#
# To provision the credentials use /usr/local/bin/d211-network.sh (or
# write /etc/wpa_supplicant.conf yourself).
#

DAEMON=/usr/sbin/wpa_supplicant
CONF="${WIFI_CONF:-/etc/wpa_supplicant.conf}"
IFACE="${WIFI_IFACE:-wlan0}"
WAIT_IFACE=20
WAIT_CARRIER=30

wait_iface() {
	i=0
	while [ ! -e "/sys/class/net/$IFACE" ] && [ $i -lt $1 ]; do
		sleep 1
		i=$((i + 1))
	done
	[ -e "/sys/class/net/$IFACE" ]
}


start() {
	if [ ! -x "$DAEMON" ]; then
		echo "S91wifi: $DAEMON not installed, skip"
		return 0
	fi

	if [ ! -f "$CONF" ]; then
		echo "S91wifi: no $CONF, Wi-Fi not provisioned, skip"
		return 0
	fi

	if ! wait_iface $WAIT_IFACE; then
		echo "S91wifi: $IFACE did not appear"
		return 1
	fi

	printf "Starting wpa_supplicant on %s: " "$IFACE"
	$DAEMON -B -i "$IFACE" -c "$CONF" -D nl80211

	i=0
	while [ "$(cat /sys/class/net/$IFACE/carrier 2>/dev/null)" != "1" ] && \
	      [ $i -lt $WAIT_CARRIER ]; do
		sleep 1
		i=$((i + 1))
	done

	if [ "$(cat /sys/class/net/$IFACE/carrier 2>/dev/null)" != "1" ]; then
		echo "no carrier"
		return 1
	fi
	echo "associated"

	# Keep trying in the background: association can take a moment and
	# the first DHCP attempt may race with the AP's key exchange.
	udhcpc -b -i "$IFACE" -R -p "/var/run/udhcpc.$IFACE.pid" >/dev/null 2>&1
	return 0
}

stop() {
	printf "Stopping wpa_supplicant: "
	killall wpa_supplicant 2>/dev/null
	killall udhcpc 2>/dev/null
	echo "OK"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart | reload)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit $?
