 create mode 100644 src/font/lv_font_siyuanheiti_normal_24.c

diff --git a/src/font/lv_font.h b/src/font/lv_font.h
index e3b670c..6fb3d26 100644
--- a/src/font/lv_font.h
+++ b/src/font/lv_font.h
@@ -240,6 +240,10 @@ LV_FONT_DECLARE(lv_font_unscii_8)
