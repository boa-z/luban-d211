diff --git a/src/font/lv_font.mk b/src/font/lv_font.mk
index 2201b73..514246c 100644
--- a/src/font/lv_font.mk
+++ b/src/font/lv_font.mk
@@ -29,6 +29,7 @@ CSRCS += lv_font_montserrat_48.c
