AIC8800_FW_VERSION = 2.0
AIC8800_FW_SOURCE = aic8800_fw-$(AIC8800_FW_VERSION).tar.gz
AIC8800_FW_SITE = aic8800_fw
AIC8800_FW_ENABLE_TARBALL = YES
AIC8800_FW_ENABLE_PATCH = NO
AIC8800_FW_INSTALL_STAGING = YES
AIC8800_FW_DEPENDENCIES = linux

AIC8800_FW_CONF_OPTS += -DCMAKE_INSTALL_PREFIX=/etc/firmware

ifeq ($(AIC8800_FW_ID_AIC8800),y)
    AIC8800_FW_CONF_OPTS += -DAIC8800_FW_ID_AIC8800=ON
endif

ifeq ($(AIC8800_FW_ID_AIC8800D80),y)
    AIC8800_FW_CONF_OPTS += -DAIC8800_FW_ID_AIC8800D80=ON
endif

ifeq ($(AIC8800_FW_ID_AIC8800D80_MINI),y)
    AIC8800_FW_CONF_OPTS += -DAIC8800_FW_ID_AIC8800D80_MINI=ON
endif

ifeq ($(AIC8800_FW_ID_AIC8800D80N),y)
    AIC8800_FW_CONF_OPTS += -DAIC8800_FW_ID_AIC8800D80N=ON
endif

ifeq ($(AIC8800_FW_ID_AIC8800D80X2),y)
    AIC8800_FW_CONF_OPTS += -DAIC8800_FW_ID_AIC8800D80X2=ON
endif

ifeq ($(AIC8800_FW_ID_AIC8800D80DC),y)
    AIC8800_FW_CONF_OPTS += -DAIC8800_FW_ID_AIC8800D80DC=ON
endif

$(eval $(cmake-package))

